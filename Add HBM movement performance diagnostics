# Put this file at .github/workflows/hbm-remix-api-lights.yml in your existing build repository.
# Diagnostic logic passed local checks; this workflow performs the full Windows build.
# It builds only the x64 runtime DLL for the existing e876135b Remix installation.
name: Build HBM Remix movement diagnostics v1

"on":
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-2022
    timeout-minutes: 180
    defaults:
      run:
        shell: pwsh
        working-directory: remix

    steps:
      - name: Fetch matching Remix source and submodules
        uses: actions/checkout@v4
        with:
          repository: NVIDIAGameWorks/dxvk-remix
          ref: e876135b37295dc203ccdb7b20a8089629588201
          submodules: recursive
          fetch-depth: 1
          persist-credentials: false
          path: remix

      - name: Install build helper
        run: |
          python -m pip install meson==1.1.0
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Apply the checked draw-state ownership fix
        run: |
          @'
          import hashlib
          from pathlib import Path
          import subprocess

          expected_revision = "e876135b37295dc203ccdb7b20a8089629588201"
          actual = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
          if actual != expected_revision:
              raise SystemExit("Unexpected source revision; refusing to patch")

          path = Path("src/dxvk/rtx_render/rtx_types.h")
          original = path.read_bytes()
          data = original.replace(b"\r\n", b"\n")
          expected_before = "c6124ce05b4c4909b1f11a4430b8fb8dc6a19f3066e683f669b44a2131514d7e"
          expected_after = "59f43fad6149772694a7943ebcb1217bef610e3ac3d26b9557c4d3ed2af80cc6"
          if hashlib.sha256(data).hexdigest() != expected_before:
              raise SystemExit("Source header does not match the tested patch")

          old = (
              b"  DrawCallState() = default;\n"
              b"  DrawCallState(const DrawCallState& _input) = default;\n"
              b"  DrawCallState& operator=(const DrawCallState& drawCallState) = default;\n"
          )
          new = old + (
              b"  // Queue transfers must relinquish geometry resources in consumed ring slots.\n"
              b"  DrawCallState(DrawCallState&&) = default;\n"
              b"  DrawCallState& operator=(DrawCallState&&) = default;\n"
          )
          if data.count(old) != 1:
              raise SystemExit("Patch location is not unique")
          patched = data.replace(old, new)
          if hashlib.sha256(patched).hexdigest() != expected_after:
              raise SystemExit("Patched header failed verification")
          path.write_bytes(patched.replace(b"\n", b"\r\n") if b"\r\n" in original else patched)
          print("Applied the validated VRAM queue fix. No BLAS animation fix is included.")
          '@ | python -
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          git diff --check
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          git diff --stat

      - name: Apply and verify the index patch
        run: |
          @'
          from pathlib import Path
          import hashlib
          import subprocess

          revision = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
          if revision != "e876135b37295dc203ccdb7b20a8089629588201":
              raise SystemExit("Unexpected source revision; refusing to patch")
          path = Path("src/d3d9/d3d9_rtx_geometry.cpp")
          raw = path.read_bytes()
          original = raw.replace(b"\r\n", b"\n").decode("utf-8")
          if hashlib.sha256(original.encode()).hexdigest() != "7c57e05e1de39085d5e8b620a72e06fe163bd64995a691cccbc586a6f734a80e":
              raise SystemExit("Geometry source differs from the checked revision")
          helper = r"""/*
           * Copyright (c) 2026.
           * Permission is hereby granted, free of charge, to any person obtaining a copy
           * of this software and associated documentation files (the "Software"), to
           * deal in the Software without restriction, including without limitation the
