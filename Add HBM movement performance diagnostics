                  raise SystemExit("Nonunique diagnostic location: " + op["file"])
              patched[op["file"]] = text.replace(op["before"], op["after"])
          for name, text in patched.items():
              if hashlib.sha256(text.encode()).hexdigest() != data["hashes"][name]["after"]:
