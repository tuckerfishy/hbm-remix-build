          original = {}
          patched = {}
          for name, hashes in data["hashes"].items():
              raw = Path(name).read_bytes()
              text = raw.replace(b"\r\n", b"\n").decode("utf-8")
              if hashlib.sha256(text.encode()).hexdigest() != hashes["before"]:
